{
  "name": "@jwpkg/gitversion-plugin-bicep",
  "packageManager": "yarn@4.0.2",
  "main": "src/index.ts",
  "scripts": {
    "build": "rm -f tsconfig.tsbuildinfo && tsc --noEmit false",
    "watch": "rm -f tsconfig.tsbuildinfo && tsc --noEmit false --watch",
    "prepack": "yarn build",
    "postpack": "rm -rf lib"
  },
  "engines": {
    "node": ">=18.12.0"
  },
  "files": [
    "/lib/**/!(*._test_).(js|d.ts)"
  ],
  "publishConfig": {
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts"
  },
  "dependencies": {
    "@jwpkg/gitversion": "workspace:^",
    "colorize-node": "^1.0.1",
    "glob": "^10.3.10",
    "semver": "^7.7.2",
    "typanion": "^3.14.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "@types/semver": "^7.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jwpkg/gitversion",
    "directory": "workspaces/packages/gitversion-plugin-bicep"
  }
}
