{
  "name": "@jwpkg/gitversion-plugin-bicep",
  "packageManager": "yarn@4.0.2",
  "main": "src/index.ts",
  "scripts": {
    "build": "rm -f tsconfig.tsbuildinfo && tsc --noEmit false",
    "watch": "rm -f tsconfig.tsbuildinfo && tsc --noEmit false --watch",
    "prepack": "yarn build",
    "postpack": "rm -rf lib"
  },
  "engines": {
    "node": ">=18.12.0"
  },
  "files": [
    "/lib/**/!(*._test_).(js|d.ts)"
  ],
  "publishConfig": {
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts"
  },
  "dependencies": {
    "@jwpkg/gitversion": "^0.1.6",
    "glob": "^11.0.1",
    "semver": "^7.7.1",
    "typanion": "^3.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/semver": "^7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "version": "0.0.0"
}
